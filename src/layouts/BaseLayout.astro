---
import "../styles/global.css";
import "../styles/revamp.css";
import "@fontsource/bebas-neue";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@phosphor-icons/web/regular";
import Analytics from "@vercel/analytics/astro";
import { links } from "../data/links";

const {
  title = "Atishay Jain | AI Systems Engineer",
  description = "Atishay Jain's evidence-driven engineering portfolio.",
  robots = "index, follow",
} = Astro.props;
const githubHref = links.github.href;
const resumeHref = links.resume.href;
const linkedinHref = links.linkedin.href;
const canonicalUrl = Astro.site && !robots.startsWith("noindex") ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site ? new URL("/og-image.png", Astro.site) : undefined;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eee9dd" />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Atishay Jain - AI systems and product engineering portfolio" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="twitter:image:alt" content="Atishay Jain - AI systems and product engineering portfolio" />
    <title>{title}</title>
    {import.meta.env.PROD && <Analytics mode="production" />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-shell">
      <header class="site-header" data-site-header>
        <nav class="nav-inner" aria-label="Primary navigation">
          <a class="brand" href="/" aria-label="Atishay Jain portfolio home">
            <span class="brand-mark">AJ</span>
            <span class="brand-copy">
              <strong>Atishay Jain</strong>
              <small>Systems × Product / 2027</small>
            </span>
          </a>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
            <span>Menu</span>
            <i class="ph ph-list" aria-hidden="true"></i>
          </button>
          <div class="nav-links" id="primary-nav" data-nav-links>
            <a href="/#featured-projects">Selected work</a>
            <a href="/#about">About</a>
            <a href="/#proof">Proof</a>
            <a href="/#contact">Contact</a>
            {
              resumeHref && (
                <a class="nav-resume" href={resumeHref}>
                  <span>Resume</span>
                  <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                </a>
              )
            }
          </div>
        </nav>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="section-inner footer-inner">
          <span>© {currentYear} Atishay Jain</span>
          <span>Built with intent. Evidence before claims.</span>
          <div class="footer-links" aria-label="Social links">
            {githubHref && <a href={githubHref} target="_blank" rel="noreferrer">GitHub</a>}
            {linkedinHref && <a href={linkedinHref} target="_blank" rel="noreferrer">LinkedIn</a>}
          </div>
        </div>
      </footer>
    </div>
    <script>
      const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
      const navLinks = document.querySelector<HTMLElement>("[data-nav-links]");
      const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");

      if (navToggle && navLinks) {
        navToggle.addEventListener("click", () => {
          const isOpen = navToggle.getAttribute("aria-expanded") === "true";
          navToggle.setAttribute("aria-expanded", String(!isOpen));
          navLinks.classList.toggle("is-open", !isOpen);
          navToggle.querySelector("span")!.textContent = isOpen ? "Menu" : "Close";
          navToggle.querySelector("i")!.className = isOpen ? "ph ph-list" : "ph ph-x";
        });

        navLinks.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            navToggle.setAttribute("aria-expanded", "false");
            navLinks.classList.remove("is-open");
            navToggle.querySelector("span")!.textContent = "Menu";
            navToggle.querySelector("i")!.className = "ph ph-list";
          });
        });
      }

      const syncHeader = () => {
        siteHeader?.classList.toggle("is-scrolled", window.scrollY > 24);
      };

      window.addEventListener("scroll", syncHeader, { passive: true });
      syncHeader();
    </script>
  </body>
</html>
