---
import "../styles/global.css";
import "../styles/redesign.css";
import "../styles/redesign-fixes.css";
import "../styles/nesh-desktop.css";
import "../styles/nesh-desktop-v2.css";
import "../styles/nesh-mobile.css";
import Analytics from "@vercel/analytics/astro";
import { links } from "../data/links";
import Icon from "../components/ui/Icon.astro";

const {
  title = "Atishay Jain | AI Systems Engineer",
  description = "Atishay Jain's evidence-driven engineering portfolio.",
  robots = "index, follow",
} = Astro.props;
const githubHref = links.github.href;
const resumeHref = links.resume.href;
const linkedinHref = links.linkedin.href;
const canonicalUrl = Astro.site && !robots.startsWith("noindex") ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site ? new URL("/og-image.png", Astro.site) : undefined;
const footerReturnHref = Astro.url.pathname === "/" ? "#top" : "/#top";
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#d5cfbe" />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Atishay Jain - AI systems and product engineering portfolio" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="twitter:image:alt" content="Atishay Jain - AI systems and product engineering portfolio" />
    <title>{title}</title>
    <Analytics mode="production" />
  </head>
  <body class:list={[isHome && "home-page"]}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-shell">
      <header class="site-header">
        <nav class="nav-inner" aria-label="Primary navigation">
          <a class="brand" href="/" aria-label="Atishay Jain portfolio home">
            <span class="brand-mark">AJ</span>
            <span class="brand-copy">
              <strong>Atishay Jain</strong>
              <small>Systems × Product</small>
            </span>
          </a>
          <div class="nav-links">
            <div class="primary-nav-links">
              <a href="/#featured-projects">Work</a>
              <a href="/#about">Approach</a>
              <a href="/#systems-map">Systems</a>
              <a href="/#contact">Contact</a>
            </div>
            <div class="utility-nav-links" aria-label="Profile links">
              {resumeHref && <a class="icon-link" href={resumeHref} aria-label="Resume"><Icon name="resume" /><span>Resume</span></a>}
              {githubHref && <a class="icon-link icon-only" href={githubHref} aria-label="GitHub" target="_blank" rel="noreferrer"><Icon name="github" /></a>}
              {linkedinHref && <a class="icon-link icon-only" href={linkedinHref} aria-label="LinkedIn" target="_blank" rel="noreferrer"><Icon name="linkedin" /></a>}
            </div>
          </div>
        </nav>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="section-inner footer-inner">
          <div>
            <span class="footer-label">End of signal</span>
            <p>Built static-first with Astro, TypeScript, and evidence-safe project notes.</p>
          </div>
          <a class="footer-return" href={footerReturnHref}>Return to signal <span aria-hidden="true">↑</span></a>
        </div>
      </footer>
    </div>
    <script>
      type PortfolioWindow = Window & { portfolioScrollTo?: (top: number, reducedMotion: boolean) => void };
      let activeScrollFrame: number | null = null;

      const scrollPortfolioTo = (top: number, reducedMotion: boolean) => {
        if (activeScrollFrame !== null) {
          window.cancelAnimationFrame(activeScrollFrame);
          activeScrollFrame = null;
        }

        const start = window.scrollY;
        const destination = Math.max(top, 0);
        const distance = destination - start;
        const root = document.documentElement;
        const previousScrollBehavior = root.style.scrollBehavior;
        root.style.scrollBehavior = "auto";

        if (reducedMotion || Math.abs(distance) < 2) {
          window.scrollTo(0, destination);
          root.style.scrollBehavior = previousScrollBehavior;
          return;
        }

        const duration = Math.min(1600, Math.max(850, Math.abs(distance) * 0.22));
        const startedAt = performance.now();
        const easeInOutCubic = (progress: number) =>
          progress < 0.5 ? 4 * Math.pow(progress, 3) : 1 - Math.pow(-2 * progress + 2, 3) / 2;

        const animate = (now: number) => {
          const progress = Math.min((now - startedAt) / duration, 1);
          window.scrollTo(0, start + distance * easeInOutCubic(progress));
          if (progress < 1) activeScrollFrame = window.requestAnimationFrame(animate);
          else {
            activeScrollFrame = null;
            root.style.scrollBehavior = previousScrollBehavior;
          }
        };

        activeScrollFrame = window.requestAnimationFrame(animate);
      };

      (window as PortfolioWindow).portfolioScrollTo = scrollPortfolioTo;

      const initFooterReturn = () => {
        const footerReturn = document.querySelector<HTMLAnchorElement>(".footer-return");
        const signalTop = document.getElementById("top");
        if (!footerReturn || !signalTop || window.location.pathname !== "/") return;

        footerReturn.addEventListener("click", (event) => {
          event.preventDefault();
          if (window.location.hash !== "#top") window.history.pushState(null, "", "#top");
          const headerHeight = document.querySelector<HTMLElement>(".site-header")?.offsetHeight ?? 0;
          const destination = signalTop.getBoundingClientRect().top + window.scrollY - headerHeight;
          const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          scrollPortfolioTo(destination, reducedMotion);
        });
      };

      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initFooterReturn, { once: true });
      else initFooterReturn();
    </script>
  </body>
</html>
