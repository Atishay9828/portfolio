---
import "../styles/global.css";
import { links } from "../data/links";
import Icon from "../components/ui/Icon.astro";

const { title = "AJ | AI Systems Engineer", description = "AJ's evidence-driven portfolio shell." } = Astro.props;
const githubHref = links.github.href;
const resumeHref = links.resume.href;
const linkedinHref = links.linkedin.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <nav class="nav-inner" aria-label="Primary navigation">
          <a class="brand" href="/">AJ</a>
          <div class="nav-links">
            <a href="/#featured-projects">Work</a>
            <a href="/#lab-projects">Lab</a>
            <a href="/#systems-map">Systems</a>
            <a href="/#contact">Contact</a>
            {
              resumeHref && (
                <a class="icon-link" href={resumeHref}>
                  <Icon name="resume" />
                  <span>Resume</span>
                </a>
              )
            }
            {
              githubHref && (
                <a class="icon-link icon-only" href={githubHref} aria-label="GitHub" target="_blank" rel="noreferrer">
                  <Icon name="github" />
                </a>
              )
            }
            {
              linkedinHref && (
                <a class="icon-link icon-only" href={linkedinHref} aria-label="LinkedIn" target="_blank" rel="noreferrer">
                  <Icon name="linkedin" />
                </a>
              )
            }
          </div>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="section-inner footer-inner">
          <span>Built static-first with Astro, TypeScript, and evidence-safe project notes.</span>
        </div>
      </footer>
    </div>
  </body>
</html>
