---
import "../styles/global.css";
import { links } from "../data/links";
import Icon from "../components/ui/Icon.astro";

const {
  title = "Atishay Jain | AI Systems Engineer",
  description = "Atishay Jain's evidence-driven engineering portfolio.",
  robots = "index, follow",
} = Astro.props;
const githubHref = links.github.href;
const resumeHref = links.resume.href;
const linkedinHref = links.linkedin.href;
const canonicalUrl = Astro.site && !robots.startsWith("noindex") ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site ? new URL("/og-image.png", Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070809" />
    <meta name="robots" content={robots} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Atishay Jain - AI systems and product engineering portfolio" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="twitter:image:alt" content="Atishay Jain - AI systems and product engineering portfolio" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-shell">
      <header class="site-header">
        <nav class="nav-inner" aria-label="Primary navigation">
          <a class="brand" href="/" aria-label="Atishay Jain portfolio home">
            <span class="brand-mark">AJ</span>
            <span class="brand-copy">
              <strong>Atishay Jain</strong>
              <small>Systems × Product</small>
            </span>
          </a>
          <div class="nav-links">
            <a href="/#featured-projects">Work</a>
            <a href="/#lab-projects">Lab</a>
            <a href="/#systems-map">Systems</a>
            <a href="/#contact">Contact</a>
            {
              resumeHref && (
                <a class="icon-link" href={resumeHref}>
                  <Icon name="resume" />
                  <span>Resume</span>
                </a>
              )
            }
            {
              githubHref && (
                <a class="icon-link icon-only" href={githubHref} aria-label="GitHub" target="_blank" rel="noreferrer">
                  <Icon name="github" />
                </a>
              )
            }
            {
              linkedinHref && (
                <a class="icon-link icon-only" href={linkedinHref} aria-label="LinkedIn" target="_blank" rel="noreferrer">
                  <Icon name="linkedin" />
                </a>
              )
            }
          </div>
        </nav>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="section-inner footer-inner">
          <span>Built static-first with Astro, TypeScript, and evidence-safe project notes.</span>
        </div>
      </footer>
    </div>
  </body>
</html>
