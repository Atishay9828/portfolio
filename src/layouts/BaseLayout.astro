---
import "../styles/global.css";
import { links } from "../data/links";
import Icon from "../components/ui/Icon.astro";

const { title = "AJ | AI Systems Engineer", description = "AJ's evidence-driven portfolio shell." } = Astro.props;
const githubHref = links.github.href;
const resumeHref = links.resume.href;
const linkedinHref = links.linkedin.href;
const emailHref = links.email.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <nav class="nav-inner" aria-label="Primary navigation">
          <a class="brand" href="/">AJ</a>
          <div class="nav-links">
            <a href="/#featured-projects">Work</a>
            <a href="/#lab-projects">Lab</a>
            <a href="/#systems-map">Systems</a>
            <a href="/#contact">Contact</a>
            {
              resumeHref && (
                <a class="icon-link" href={resumeHref}>
                  <Icon name="resume" />
                  <span>{links.resume.label}</span>
                </a>
              )
            }
            {
              githubHref && (
                <a class="icon-link" href={githubHref}>
                  <Icon name="github" />
                  <span>GitHub</span>
                </a>
              )
            }
            {
              linkedinHref && (
                <a class="icon-link" href={linkedinHref}>
                  <Icon name="linkedin" />
                  <span>LinkedIn</span>
                </a>
              )
            }
          </div>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="section-inner footer-inner">
          <span>Static scaffold. Evidence-safe by default; production polish waits for portfolio-local assets.</span>
          <div class="footer-links">
            {
              resumeHref && (
                <a class="icon-link" href={resumeHref}>
                  <Icon name="resume" />
                  <span>{links.resume.label}</span>
                </a>
              )
            }
            {
              githubHref && (
                <a class="icon-link" href={githubHref}>
                  <Icon name="github" />
                  <span>GitHub</span>
                </a>
              )
            }
            {
              linkedinHref && (
                <a class="icon-link" href={linkedinHref}>
                  <Icon name="linkedin" />
                  <span>LinkedIn</span>
                </a>
              )
            }
            {
              emailHref && (
                <a class="icon-link" href={emailHref}>
                  <Icon name="mail" />
                  <span>Email</span>
                </a>
              )
            }
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
