---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Atishay Jain"
  description="The requested portfolio page could not be found."
  robots="noindex, follow"
>
  <section class="section case-hero">
    <div class="section-inner case-section-intro">
      <span class="status-label">404 / SIGNAL LOST</span>
      <h1>That route does not exist.</h1>
      <p class="lead">The portfolio is intact. Return to the homepage or jump straight to the featured systems.</p>
      <div class="project-action-row">
        <a class="button primary" href="/">Back to homepage</a>
        <a class="button secondary" href="/#featured-projects">View featured work</a>
      </div>
    </div>
  </section>
</BaseLayout>
