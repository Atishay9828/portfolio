---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ProofStrip from "../components/sections/ProofStrip.astro";
import FeaturedProjects from "../components/sections/FeaturedProjects.astro";
import Timeline from "../components/sections/Timeline.astro";
import SecondaryWork from "../components/sections/SecondaryWork.astro";
import LabProjects from "../components/sections/LabProjects.astro";
import SystemsMap from "../components/sections/SystemsMap.astro";
import About from "../components/sections/About.astro";
import Toolkit from "../components/sections/Toolkit.astro";
import Contact from "../components/sections/Contact.astro";
---

<BaseLayout title="AJ | AI Systems Engineer + Product Engineer">
  <div class="signal-journey signal-corridor" data-journey-root>
    <nav class="journey-rail" aria-label="Homepage signal journey">
      <div class="journey-rail-track" aria-hidden="true">
        <span class="journey-rail-fill"></span>
        <span class="journey-rail-orb"></span>
      </div>
      <div class="journey-stations">
        <a class="journey-station" href="#top" data-journey-nav="0">
          <span>01</span>
          <strong>Signal</strong>
        </a>
        <a class="journey-station" href="#about" data-journey-nav="1">
          <span>02</span>
          <strong>About</strong>
        </a>
        <a class="journey-station" href="#proof-strip" data-journey-nav="2">
          <span>03</span>
          <strong>Proof</strong>
        </a>
        <a class="journey-station" href="#featured-projects" data-journey-nav="3">
          <span>04</span>
          <strong>Builds</strong>
        </a>
        <a class="journey-station" href="#signal-evolution" data-journey-nav="4">
          <span>05</span>
          <strong>Evolution</strong>
        </a>
        <a class="journey-station" href="#toolkit" data-journey-nav="5">
          <span>06</span>
          <strong>Toolkit</strong>
        </a>
        <a class="journey-station" href="#systems-map" data-journey-nav="6">
          <span>07</span>
          <strong>Systems</strong>
        </a>
        <a class="journey-station" href="#contact" data-journey-nav="7">
          <span>08</span>
          <strong>Contact</strong>
        </a>
      </div>
    </nav>
    <Hero />
    <About />
    <ProofStrip />
    <FeaturedProjects />
    <Timeline />
    <Toolkit />
    <SystemsMap />
    <SecondaryWork />
    <LabProjects />
    <Contact />
  </div>
  <script>
    const initSignalJourney = () => {
      const journeyRoot = document.querySelector<HTMLElement>("[data-journey-root]");

      if (!journeyRoot) {
        return;
      }

      const journeySections = Array.from(journeyRoot.querySelectorAll<HTMLElement>("[data-journey-section]"));
      const journeyStations = Array.from(journeyRoot.querySelectorAll<HTMLElement>("[data-journey-nav]"));
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let frameRequested = false;

      const getStickyOffset = () => {
        const header = document.querySelector<HTMLElement>(".site-header");
        return (header?.offsetHeight ?? 68) + 18;
      };

      const setActiveJourneySection = (activeIndex: number) => {
        const progress = activeIndex / Math.max(journeySections.length - 1, 1);

        journeyRoot.dataset.activeJourney = String(activeIndex);
        journeyRoot.style.setProperty("--journey-progress", progress.toFixed(4));
        journeyRoot.style.setProperty("--journey-progress-percent", `${(progress * 100).toFixed(2)}%`);
        journeyRoot.style.setProperty("--journey-depth", (progress * 100).toFixed(2));

        journeySections.forEach((section, index) => {
          section.classList.toggle("is-active", index === activeIndex);
          section.classList.toggle("is-before", index < activeIndex);
          section.classList.toggle("is-after", index > activeIndex);
        });

        journeyStations.forEach((station, index) => {
          station.classList.toggle("is-active", index === activeIndex);
          station.classList.toggle("is-before", index < activeIndex);
        });
      };

      const syncScrollMargins = () => {
        const scrollMarginTop = `${getStickyOffset() + 8}px`;
        journeySections.forEach((section) => {
          section.style.scrollMarginTop = scrollMarginTop;
        });
      };

      const updateJourney = () => {
        frameRequested = false;

        if (journeySections.length === 0) {
          return;
        }

        const viewportHeight = window.innerHeight || 1;
        const targetLine = Math.min(viewportHeight * 0.38, 260) + getStickyOffset();

        let activeIndex = 0;
        let closestDistance = Number.POSITIVE_INFINITY;

        journeySections.forEach((section, index) => {
          const rect = section.getBoundingClientRect();
          const sectionAnchor = rect.top + Math.min(rect.height * 0.24, 180);
          const distance = Math.abs(sectionAnchor - targetLine);

          if (distance < closestDistance) {
            closestDistance = distance;
            activeIndex = index;
          }
        });

        setActiveJourneySection(activeIndex);
      };

      const requestJourneyUpdate = () => {
        if (!frameRequested) {
          frameRequested = true;
          window.requestAnimationFrame(updateJourney);
        }
      };

      const enterObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("has-entered");
            }
          });
        },
        {
          rootMargin: "0px 0px -12% 0px",
          threshold: 0.12,
        },
      );

      journeySections.forEach((section) => enterObserver.observe(section));
      syncScrollMargins();

      journeyStations.forEach((station) => {
        station.addEventListener("click", (event) => {
          const href = station.getAttribute("href");
          const targetIndex = Number(station.dataset.journeyNav ?? "0");
          const target = href ? document.querySelector<HTMLElement>(href) : null;

          if (!target) {
            return;
          }

          event.preventDefault();
          syncScrollMargins();
          setActiveJourneySection(targetIndex);
          window.scrollTo({
            top: target.getBoundingClientRect().top + window.scrollY - getStickyOffset(),
            behavior: reducedMotion.matches ? "auto" : "smooth",
          });
        });
      });

      window.addEventListener("scroll", requestJourneyUpdate, { passive: true });
      window.addEventListener("resize", () => {
        syncScrollMargins();
        requestJourneyUpdate();
      });
      reducedMotion.addEventListener("change", requestJourneyUpdate);
      updateJourney();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSignalJourney, { once: true });
    } else {
      initSignalJourney();
    }
  </script>
</BaseLayout>
