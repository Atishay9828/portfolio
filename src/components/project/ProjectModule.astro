---
import type { Project } from "../../data/projects";
import Icon from "../ui/Icon.astro";

const { project, compact = false, index } = Astro.props as { project: Project; compact?: boolean; index?: number };
const visualAssets = project.visual.assets ?? [];
const primaryVisual = visualAssets.find((asset) => !asset.src.toLowerCase().endsWith(".svg")) ?? visualAssets[0];
const caseStudyHref = project.tier === "Featured" ? `/projects/${project.slug}/` : undefined;
const visibleStack = project.stack.slice(0, compact ? 4 : 3);
const displayIndex = index ? String(index).padStart(2, "0") : undefined;
const moduleClass = compact ? "compact-module" : "project-module";

type ProjectActionIcon = "github" | "notebook" | "kaggle" | "huggingFace" | "demo" | "video" | "deployment" | "page" | "arrowRight";

const getAction = (label: string): { icon: ProjectActionIcon; label: string } => {
  const normalizedLabel = label.toLowerCase();
  if (normalizedLabel.includes("github")) return { icon: "github", label: "GitHub" };
  if (normalizedLabel.includes("kaggle") || normalizedLabel.includes("notebook")) return { icon: "kaggle", label: "Kaggle" };
  if (normalizedLabel.includes("hugging")) return { icon: "huggingFace", label: "Hugging Face" };
  if (normalizedLabel.includes("youtube")) return { icon: "video", label: "YouTube" };
  if (normalizedLabel.includes("deployment") || normalizedLabel.includes("live")) return { icon: "deployment", label: "Live" };
  return { icon: "arrowRight", label };
};
---

<article
  class:list={[moduleClass, "work-card", compact && "is-compact"]}
  id={displayIndex ? `work-${project.slug}` : undefined}
  data-work-card={displayIndex ? "" : undefined}
  data-work-index={displayIndex}
>
  <div class="work-card__top">
    <div class="work-card__tags">{visibleStack.map((item) => <span>{item}</span>)}</div>
  </div>

  <div class="work-card__visual evidence-panel">
    {
      primaryVisual ? (
        <img src={primaryVisual.src} alt={primaryVisual.alt ?? primaryVisual.label} loading="lazy" />
      ) : (
        <div class="work-card__visual-copy"><span>{project.tier}</span><strong>{project.statusLabel}</strong></div>
      )
    }
    <span class="sr-only">Proof on file: {project.visual.label}</span>
  </div>

  <div class="work-card__content">
    <span class="status-label">{project.tier.toUpperCase()} / {project.statusLabel.toUpperCase()}</span>
    <h3>{caseStudyHref ? <a class="project-title-link" href={caseStudyHref}>{project.title}</a> : project.title}</h3>
    <p class="project-summary">{compact ? project.subtitle : project.problem}</p>
    {!compact && project.homepageLesson && <p class="project-lesson"><span>What I learned</span>{project.homepageLesson}</p>}
    {compact && <p class="compact-summary">{project.problem}</p>}
    <div class="project-action-row" aria-label={`${project.title} links`}>
      {caseStudyHref && <a class="project-action project-card-link" href={caseStudyHref}><Icon name="page" /><span>Case study</span></a>}
      {
        project.links.map((projectLink) => {
          const action = getAction(projectLink.label);
          const link = { ...projectLink, isExternal: projectLink.href.startsWith("https://") };
          return (
            <a
              class="project-action"
              href={link.href}
              target={link.isExternal ? "_blank" : undefined}
              rel={link.isExternal ? "noreferrer" : undefined}
              aria-label={`${action.label}: ${project.title}`}
            >
              <Icon name={action.icon} /><span>{action.label}</span>
            </a>
          );
        })
      }
    </div>
  </div>
</article>
