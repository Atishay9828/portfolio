---
import type { Project } from "../../data/projects";
import Icon from "../ui/Icon.astro";

const { project, compact = false } = Astro.props as { project: Project; compact?: boolean };
const moduleClass = compact ? "compact-module" : "project-module";
const visualAssets = project.visual.assets ?? [];
const evidenceClass = `evidence-panel evidence-${project.visual.status.toLowerCase().replaceAll(" ", "-")}`;
const caseStudyHref = project.tier === "Featured" ? `/projects/${project.slug}/` : undefined;

type ProjectActionIcon =
  | "github"
  | "notebook"
  | "kaggle"
  | "huggingFace"
  | "demo"
  | "video"
  | "deployment"
  | "page"
  | "arrowRight";

const getAction = (label: string): { icon: ProjectActionIcon; label: string; description: string } => {
  const normalizedLabel = label.toLowerCase();

  if (normalizedLabel.includes("github")) {
    return { icon: "github", label: "GitHub", description: "Source repo" };
  }

  if (normalizedLabel.includes("kaggle") || normalizedLabel.includes("notebook")) {
    return { icon: "kaggle", label: "Kaggle", description: "Training notebook" };
  }

  if (normalizedLabel.includes("hugging")) {
    return { icon: "huggingFace", label: "Hugging Face", description: "Interactive demo" };
  }

  if (normalizedLabel.includes("youtube")) {
    return { icon: "video", label: "YouTube", description: "Walkthrough" };
  }

  if (normalizedLabel.includes("deployment") || normalizedLabel.includes("live")) {
    return { icon: "deployment", label: "Live", description: "Deployment" };
  }

  return { icon: "arrowRight", label, description: "External proof" };
};
---

<article class={moduleClass}>
  <div>
    <div class="status-label">{project.tier} / {project.statusLabel}</div>
    <h3>
      {caseStudyHref ? (
        <a class="project-title-link" href={caseStudyHref}>{project.title}</a>
      ) : (
        project.title
      )}
    </h3>
    <p>{project.subtitle}</p>
    <div class="project-meta">
      {project.stack.map((item) => <span class="tag">{item}</span>)}
    </div>
    {compact ? (
      <p class="compact-summary">{project.problem}</p>
    ) : (
      <div class="project-facts">
        <div class="fact">
          <strong>Portfolio role</strong>
          <span>{project.portfolioRole}</span>
        </div>
        <div class="fact">
          <strong>Problem</strong>
          <span>{project.problem}</span>
        </div>
        <div class="fact">
          <strong>Key engineering decision</strong>
          <span>{project.keyDecision}</span>
        </div>
        <div class="fact">
          <strong>Limitation / tradeoff</strong>
          <span>{project.tradeoff}</span>
        </div>
        {project.contribution ? (
          <div class="fact fact-note">
            <strong>{project.contribution.roleLabel}</strong>
            <span>{project.contribution.summary}</span>
          </div>
        ) : (
          <div class="fact fact-note">
            <strong>{project.roleStatus}</strong>
          </div>
        )}
      </div>
    )}
    <div class="project-action-row" aria-label={`${project.title} links`}>
      {caseStudyHref && (
        <a class="project-action project-card-link" href={caseStudyHref}>
          <Icon name="page" />
          <span>Case study</span>
        </a>
      )}
      {project.links.map((projectLink) => {
        const action = getAction(projectLink.label);
        const link = { ...projectLink, isExternal: projectLink.href.startsWith("https://") };
        return (
          <a
            class="project-action"
            href={link.href}
            target={link.isExternal ? "_blank" : undefined}
            rel={link.isExternal ? "noreferrer" : undefined}
            aria-label={`${action.label}: ${project.title}`}
          >
            <Icon name={action.icon} />
            <span>{action.label}</span>
            <small>{action.description}</small>
          </a>
        );
      })}
    </div>
  </div>
  {!compact && (
    <aside class={evidenceClass} aria-label={`${project.title} evidence status`}>
      <div>
        <span class="status-pill">{project.visual.status}</span>
        <h3>{project.visual.label}</h3>
        <p>{project.visual.detail}</p>
      </div>
      {visualAssets.length > 0 && (
        <div class="evidence-assets" aria-label={`${project.title} visual evidence`}>
          {visualAssets.slice(0, 2).map((asset) => (
            <figure class="evidence-asset">
              <img src={asset.src} alt={asset.alt ?? asset.label} loading="lazy" />
              <figcaption>
                <strong>{asset.label}</strong>
                <span>{asset.status}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </aside>
  )}
</article>
