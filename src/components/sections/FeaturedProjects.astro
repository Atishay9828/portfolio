---
import SectionHeader from "../ui/SectionHeader.astro";
import ProjectModule from "../project/ProjectModule.astro";
import { featuredProjects } from "../../data/projects";
---

<section class="section" id="featured-projects">
  <div class="section-inner">
    <div class="section-marker" aria-hidden="true">
      <span>03</span>
      <strong>Featured Builds</strong>
    </div>
    <SectionHeader
      eyebrow="Featured projects"
      title="The strongest proof first"
      body="Project cards show verified links, reviewed candidate visuals, and explicit missing-proof indicators. Screenshots and metrics stay labeled until the supporting evidence is complete."
    />
    <div class="featured-stack">
      {featuredProjects.map((project) => <ProjectModule project={project} />)}
    </div>
  </div>
</section>
