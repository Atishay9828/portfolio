---
import SectionHeader from "../ui/SectionHeader.astro";
import ProjectModule from "../project/ProjectModule.astro";
import { featuredProjects } from "../../data/projects";
---

<section class="section" id="featured-projects" data-journey-section data-journey-label="Featured builds" data-journey-index="3">
  <div class="section-inner">
    <div class="section-marker" aria-hidden="true">
      <span>04</span>
      <strong>Featured Builds</strong>
    </div>
    <SectionHeader
      eyebrow="Featured projects"
      title="The strongest proof first"
      body="Three projects with code, workflow, and proof."
    />
    <div class="featured-stack">
      {featuredProjects.map((project) => <ProjectModule project={project} />)}
    </div>
  </div>
</section>
