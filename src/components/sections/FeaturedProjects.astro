---
import SectionHeader from "../ui/SectionHeader.astro";
import ProjectModule from "../project/ProjectModule.astro";
import { featuredProjects } from "../../data/projects";
---

<section class="section" id="featured-projects" data-journey-section data-journey-label="Featured builds" data-journey-index="2">
  <div class="section-inner">
    <div class="section-marker" aria-hidden="true">
      <span>03</span>
      <strong>Featured Builds</strong>
    </div>
    <SectionHeader
      eyebrow="Featured projects"
      title="Three systems that changed how I build"
      body="Adaptive behavior, local AI routing, and campus coordination each introduced a different engineering constraint."
    />
    <div class="featured-stack">
      {featuredProjects.map((project) => <ProjectModule project={project} />)}
    </div>
  </div>
</section>
