---
import SectionHeader from "../ui/SectionHeader.astro";
import { featuredProjects, secondaryProjects, timelineProjectLinks, timelineStages } from "../../data/projects";

const projectLinks = new Map<string, { href: string; external: boolean }>(
  [
    ...featuredProjects.map(
      (project) => [project.title, { href: `/projects/${project.slug}/`, external: false }] as const,
    ),
    ...secondaryProjects.flatMap((project) => {
      const repoLink = project.links.find(
        (link) => link.status === "Verified" && link.label.toLowerCase().includes("github"),
      );

      return repoLink ? ([[project.title, { href: repoLink.href, external: true }] as const] as const) : [];
    }),
    ...Object.entries(timelineProjectLinks),
  ],
);
---

<section class="section" id="signal-evolution" data-journey-section data-journey-label="Evolution" data-journey-index="4">
  <div class="section-inner">
    <div class="section-marker" aria-hidden="true">
      <span>05</span>
      <strong>Evolution</strong>
    </div>
    <SectionHeader
      eyebrow="Signal evolution"
      title="Build progression"
      body="Projects that shaped the stack."
    />
    <div class="timeline">
      {timelineStages.map((stage, index) => (
        <article class="timeline-card">
          <div>
            <span class="timeline-index">{String(index + 1).padStart(2, "0")}</span>
            <span class="meta-label">{stage.label}</span>
          </div>
          <div>
            <h3>
              {stage.projects.map((projectName, projectIndex) => {
                const link = projectLinks.get(projectName);

                return (
                  <>
                    {projectIndex > 0 && <span class="project-separator"> / </span>}
                    {link ? (
                      <a
                        class="timeline-project-link"
                        href={link.href}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noreferrer" : undefined}
                      >
                        {projectName}
                      </a>
                    ) : (
                      <span>{projectName}</span>
                    )}
                  </>
                );
              })}
            </h3>
            <p>{stage.capability}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
