---
import SectionHeader from "../ui/SectionHeader.astro";
import { labProjects } from "../../data/projects";
---

<section class="section" id="lab-projects">
  <div class="section-inner">
    <div class="section-marker" aria-hidden="true">
      <span>07B</span>
      <strong>Lab</strong>
    </div>
    <SectionHeader
      eyebrow="Lab Projects"
      title="Focused Experiments"
      body="Focused experiments across retrieval, scraping, data, and analysis."
    />
    <div class="lab-grid">
      {labProjects.map((project) => (
        project.repoHref ? (
          <a class="lab-entry lab-card-link" href={project.repoHref} target="_blank" rel="noreferrer">
            <span class="meta-label">{project.category}</span>
            <h3>{project.title}</h3>
            <p>{project.purpose}</p>
            <p>{project.status}</p>
          </a>
        ) : (
          <article class="lab-entry lab-card-static">
            <span class="meta-label">{project.category}</span>
            <h3>{project.title}</h3>
            <p>{project.purpose}</p>
            <p>{project.status}</p>
          </article>
        )
      ))}
    </div>
  </div>
</section>
