---
import SectionHeader from "../ui/SectionHeader.astro";
import { labProjects } from "../../data/projects";
---

<section class="section" id="lab-projects">
  <div class="section-inner">
    <div class="section-marker" aria-hidden="true">
      <span>07B</span>
      <strong>Lab</strong>
    </div>
    <SectionHeader
      eyebrow="Lab Projects"
      title="Focused Experiments"
      body="Small builds that show foundations without competing with the featured work."
    />
    <div class="lab-grid">
      {labProjects.map((project) => (
        <article class="lab-entry">
          <span class="meta-label">{project.category}</span>
          <h3>{project.title}</h3>
          <p>{project.purpose}</p>
          <p>{project.status}</p>
        </article>
      ))}
    </div>
  </div>
</section>
