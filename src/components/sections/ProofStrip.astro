---
import SectionHeader from "../ui/SectionHeader.astro";
import { evidenceSummary } from "../../data/evidence";
---

<section class="section" id="proof-strip" data-journey-section data-journey-label="Proof anchors" data-journey-index="2">
  <div class="section-inner">
    <div class="section-marker" aria-hidden="true">
      <span>03</span>
      <strong>Proof Anchors</strong>
    </div>
    <SectionHeader
      eyebrow="Proof strip"
      title="Evidence before claims"
      body="Verified links, local measurements, and prototype boundaries stay separated."
    />
    <div class="proof-grid">
      {evidenceSummary.map((item) => (
        <div class="proof-cell">
          <span class="meta-label">{item.label}</span>
          <strong>{item.value}</strong>
          <p>{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
