---
import { featuredProjects } from "../../data/projects";
import { links } from "../../data/links";
import Icon from "../ui/Icon.astro";
---

<section class="hero" id="top">
  <div class="section-inner hero-grid">
    <div class="hero-copy">
      <div class="section-marker" aria-hidden="true">
        <span>01</span>
        <strong>Signal</strong>
      </div>
      <div class="eyebrow">AJ / Computer Engineering</div>
      <h1>
        <span class="hero-title-line">AI systems.</span>
        <span class="hero-title-line">Product workflows.</span>
        <span class="hero-title-line">Proof-first engineering.</span>
      </h1>
      <div class="identity-line">
        <span>AI Systems Engineer</span>
        <span>Product Engineer</span>
      </div>
      <p class="lead">
        I build software where models, data, APIs, memory, interfaces, and user workflows meet real constraints.
      </p>
      <div class="cta-row">
        <a class="button primary" href="#featured-projects">
          <span>Featured work</span>
          <Icon name="arrowRight" />
        </a>
        {
          links.github.href && (
            <a class="button secondary" href={links.github.href}>
              <Icon name="github" />
              <span>GitHub</span>
            </a>
          )
        }
        {
          links.resume.href && (
            <a class="button secondary" href={links.resume.href}>
              <Icon name="resume" />
              <span>{links.resume.label}</span>
            </a>
          )
        }
      </div>
    </div>
    <aside class="anchor-panel hero-visual-panel" aria-label="Featured project anchors">
      <div class="hero-signal-map" aria-label="Abstract systems chain">
        <div class="signal-map-header">
          <span class="meta-label">Signal path</span>
          <span>static proof chain</span>
        </div>
        <div class="signal-chain" aria-hidden="true">
          {["Model", "API", "Memory", "UI", "Proof"].map((item) => (
            <span>{item}</span>
          ))}
        </div>
        <div class="signal-role-stack" aria-label="Current role stack">
          {["AI Systems", "Product Workflows", "Local Inference", "Evidence First"].map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </div>
      <div class="meta-label">Proof anchors</div>
      <div class="anchor-list">
        {featuredProjects.map((project) => (
          <a class="anchor-item" href={`/projects/${project.slug}`}>
            <strong>{project.title}</strong>
            <p>{project.subtitle}</p>
            <span>{project.statusLabel}</span>
          </a>
        ))}
      </div>
    </aside>
  </div>
</section>
