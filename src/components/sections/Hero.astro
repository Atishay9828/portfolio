---
import { featuredProjects } from "../../data/projects";
import { links } from "../../data/links";
import Icon from "../ui/Icon.astro";
---

<section class="hero" id="top" data-journey-section data-journey-label="Signal" data-journey-index="0">
  <div class="section-inner hero-grid">
    <div class="hero-copy">
      <div class="section-marker" aria-hidden="true">
        <span>01</span>
        <strong>Signal</strong>
      </div>
      <div class="eyebrow">Atishay Jain / Computer Engineering</div>
      <div class="hero-mobile-profile" aria-hidden="true">
        <img
          src="/assets/profile/atishay-jain-portrait.webp"
          alt=""
          width="720"
          height="900"
          loading="eager"
          decoding="async"
        />
        <div>
          <strong>Atishay Jain</strong>
          <span>Builder behind the systems</span>
        </div>
      </div>
      <h1>
        <span class="hero-title-line">AI systems.</span>
        <span class="hero-title-line">Product workflows.</span>
        <span class="hero-title-line">Proof-first engineering.</span>
      </h1>
      <div class="identity-line">
        <span>AI Systems Engineer</span>
        <span>Product Engineer</span>
      </div>
      <p class="lead">
        I build AI-enabled products by turning models, APIs, data, and user flows into systems with explicit
        fallbacks, clear workflows, and honest limits.
      </p>
      <div class="cta-row">
        <a class="button primary" href="#featured-projects">
          <span>Featured work</span>
          <Icon name="arrowRight" />
        </a>
        {
          links.github.href && (
            <a class="button secondary" href={links.github.href} target="_blank" rel="noreferrer">
              <Icon name="github" />
              <span>GitHub</span>
            </a>
          )
        }
        {
          links.resume.href && (
            <a class="button secondary" href={links.resume.href}>
              <Icon name="resume" />
              <span>{links.resume.label}</span>
            </a>
          )
        }
      </div>
    </div>
    <aside class="anchor-panel hero-visual-panel" aria-label="Featured project anchors">
      <figure class="hero-profile">
        <div class="hero-profile__portrait">
          <img
            src="/assets/profile/atishay-jain-portrait.webp"
            alt="Atishay Jain in a black shirt, smiling with his arms crossed"
            width="720"
            height="900"
            loading="eager"
            decoding="async"
          />
          <span aria-hidden="true">AJ / 01</span>
        </div>
        <figcaption>
          <span class="meta-label">Builder profile</span>
          <strong>Atishay Jain</strong>
          <p>Computer Engineering student building complete AI systems and practical product workflows.</p>
        </figcaption>
      </figure>
      <div class="hero-proof-heading">
        <div class="meta-label">Proof anchors</div>
        <span>Inspect the work</span>
      </div>
      <div class="anchor-list">
        {featuredProjects.map((project) => (
          <a class="anchor-item" href={`/projects/${project.slug}/`}>
            <strong>{project.title}</strong>
            <p>{project.subtitle}</p>
            <span>{project.statusLabel}</span>
          </a>
        ))}
      </div>
    </aside>
  </div>
</section>
