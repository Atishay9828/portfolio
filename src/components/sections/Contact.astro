---
import { links } from "../../data/links";
import Icon from "../ui/Icon.astro";
---

<section class="section" id="contact" data-journey-section data-journey-label="Contact" data-journey-index="6">
  <div class="section-inner contact-grid">
    <div>
      <div class="section-marker" aria-hidden="true">
        <span>07</span>
        <strong>Contact</strong>
      </div>
      <div class="eyebrow">Contact</div>
      <h2>Inspect the evidence, then let's talk.</h2>
      <p class="lead">For software, AI systems, or product engineering opportunities, these are the direct paths.</p>
    </div>
    <div class="case-panel">
      <div class="link-row">
        {
          links.github.href && (
            <a class="button secondary" href={links.github.href} target="_blank" rel="noreferrer">
              <Icon name="github" />
              <span>GitHub</span>
            </a>
          )
        }
        {
          links.resume.href && (
            <a class="button secondary" href={links.resume.href}>
              <Icon name="resume" />
              <span>{links.resume.label}</span>
            </a>
          )
        }
        {
          links.linkedin.href && (
            <a class="button secondary" href={links.linkedin.href} target="_blank" rel="noreferrer">
              <Icon name="linkedin" />
              <span>LinkedIn</span>
            </a>
          )
        }
        {
          links.email.href && (
            <a class="button secondary" href={links.email.href}>
              <Icon name="mail" />
              <span>Email</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
