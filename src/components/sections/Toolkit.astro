---
import SectionHeader from "../ui/SectionHeader.astro";
import { toolkit } from "../../data/toolkit";

const groupedToolkit = toolkit.reduce<Record<string, typeof toolkit>>((groups, item) => {
  groups[item.category] = [...(groups[item.category] ?? []), item];
  return groups;
}, {});
---

<section class="section" id="toolkit" data-journey-section data-journey-label="Toolkit" data-journey-index="4">
  <div class="section-inner">
    <div class="section-marker" aria-hidden="true">
      <span>05</span>
      <strong>Toolkit</strong>
    </div>
    <SectionHeader
      eyebrow="Toolkit"
      title="Tools chosen for the job"
      body="Grouped from project evidence; the stack supports the engineering decisions above."
    />
    <div class="toolkit-grid">
      {Object.entries(groupedToolkit).map(([category, items]) => (
        <article class="toolkit-group">
          <span class="meta-label">{category}</span>
          <div class="toolkit-list">
            {items.map((item) => (
              <span class="toolkit-chip" title={`${item.project}: ${item.evidenceSource} (${item.proofFile})`}>
                <span>{item.name}</span>
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
